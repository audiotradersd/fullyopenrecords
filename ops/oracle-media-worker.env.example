# Copy to /etc/fullyopen-media-worker.env, fill in the values, then chmod 600.
API_BASE=https://fully-open-records-api.sbdownes.workers.dev
MEDIA_PROCESSOR_TOKEN=replace-with-the-same-secret-stored-in-Cloudflare
R2_MASTERS_REMOTE=r2-masters:fully-open-records-masters
R2_MEDIA_REMOTE=r2-media:fully-open-records-media
LFTP_CONFIG=/home/ubuntu/citrus3.lftp
CITRUS_REMOTE_DIR=from_web
